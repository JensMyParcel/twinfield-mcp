{
  "name": "twinfield-mcp",
  "version": "0.1.0",
  "description": "MCP server for the complete Twinfield accounting web service API.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "twinfield-mcp": "dist/bin/stdio.js",
    "twinfield-mcp-login": "dist/bin/login.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin/stdio.js dist/bin/login.js",
    "generate": "tsx scripts/generate-catalog.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "check": "npm run generate -- --check && npm run typecheck && npm run lint && prettier --check . && npm test && npm run build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "fast-xml-parser": "5.12.0",
    "fast-xml-validator": "1.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "files": [
    "dist",
    "vendor/twinfield/docs"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
